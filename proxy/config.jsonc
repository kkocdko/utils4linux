// prettier-ignore
// https://kkocdko.site/hidden/proxy/config.jsonc?user=a&&token=b
// >>> client
{
  "experimental": {
    "cache_file": { "enabled": true }, // 别用 store_fakeip，在极端情况下会让错误无法恢复
    "clash_api": { "external_controller": "127.0.0.1:9090", "external_ui": "ui", "external_ui_download_url": "https://github.com/kkocdko/kblog/releases/download/simple_storage/yacd-meta-mod-20250210-0204.zip" } // 打开 http://yacd.localhost:9090/ui 即可。建议把延迟测试地址改成有点体积的，更能反映实际情况的 https://www.google.com/robots.txt 而不是 generate_204
  },
  "dns": {
    "servers": [
      { "tag": "local", "type": "local" },
      { "tag": "google", "type": "https", "server": "8.8.8.8", "detour": "proxy" }, // 小技巧 https://1.12.12.12/resolve?type=A&name=qq.com
      { "tag": "fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18" } // 退出后 fakeip 会导致短期内解析异常，但我建议在必要时切换到 direct 而非退出
    ],
    "rules": [{ "query_type": ["A", "AAAA"], "server": "fakeip" }], // 尽量让落地服务器做 dns 查询
    "strategy": "prefer_ipv4",
    "independent_cache": true // 也许可以不要让 fakeip 和其他 dns 缓存混淆
  },
  "route": {
    "default_domain_resolver": "local", // 规则下载 url、节点服务器域名等会使用此 dns 解析
    "rule_set": [
      { "tag":"site-ad", "type":"remote", "url":"https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set-geosite/geosite-category-ads-all.srs" },
      { "tag":"site-not-cn", "type":"remote", "url":"https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-!cn.srs" },
      { "tag":"site-cn", "type":"remote", "url":"https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-cn.srs" },
      { "tag":"site-cn-ext", "type":"remote", "url":"https://raw.githubusercontent.com/xmdhs/cn-domain-list/rule-set/ext-cn-list.srs" },
      { "tag":"ip-cn", "type":"remote", "url":"https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"}
    ],
    "rules": [
      // { "domain": "ender3v3ke.internal", "override_address": "192.168.1.5", "outbound": "direct" }, // for i in $(seq 2 9); do u=http://192.168.1.$i ; timeout 1 curl -s $u | grep -q ">Creality<" && echo $u && break ; done
      // { "domain_suffix": [".lan", "lazycat.ai"], "outbound": "lnks-direct" },
      { "action": "sniff" }, // 协议嗅探。劫持 dns、禁用 quic 等功能都依赖于此
      { "protocol": "quic", "action": "reject" }, // 嵌套 quic 抖动很大，强迫浏览器 h3 回落到其他协议
      { "protocol": "dns", "action": "hijack-dns" }, // 劫持 dns，省去手动设置。请卸载 systemd-resolved
      { "ip_is_private": true, "outbound": "direct" }, // 注意顺序，内网 dns 依然会被上一条劫持
      { "clash_mode": "Direct", "outbound": "direct" }, // 注意顺序，放在开头将导致 direct 模式下 dns 不被劫持
      { "clash_mode": "Global", "outbound": "proxy" }, // 尽量不要用全局模式
      { "clash_mode": "Turbo", "rule_set": ["site-ad"], "domain_suffix": ["dldir1.qq.com","dldir1v6.qq.com","dldir2.qq.com","dldir2v6.qq.com","douyinvod.com"], "action": "reject" }, // 微信 qq 更新和 tinker 热更新，抖音 cdn。别用 method drop，会导致某些应用出现 ANR
      { "domain_suffix": ["dns.weixin.qq.com", "dns.weixin.qq.com.cn"], "action": "reject" }, // 屏蔽微信内置 doh，避免 ipv6 下出现问题，见下文中的 tun
      { "package_name": ["com.tencent.mm", "com.tencent.mobileqq", "com.eg.android.AlipayGphone", "com.ss.android.ugc.aweme.lite", "com.autonavi.minimap", "com.cainiao.wireless", "com.hellotalk"], "outbound": "direct" }, // 需屏蔽广告的应用应当写到这里，而不是绕过 tun
      { "domain_suffix": [".edu.cn", ".gov.cn", ".lan", ".internal", "tailscale.com", "kkocdko.site", "kekeka.cc.cd", "girigirilove.com", "lazycat.ai", "tokenrhythm.studio", "anytokens.cc", "ai.laodog.top", "api.flymux.com", "token.moxiangketang.com", "api.freemodel.dev", "api.aicoding.sh", "hyperapi.cc", "xproxy.ai", "booltoken.com"], "domain_keyword": [".ffzy-"], "outbound": "direct" }, // 额外一些应当直连的，例如 edu.cn 顶域和 非凡资源视频站
      { "domain_suffix": ["google.cn"], "outbound": "proxy" }, // 虽然没被彻底屏蔽，但是最好走代理
      // { "domain_suffix": ["youtube.com", "googlevideo.com", "twitch.tv", "ttvnw.net"], "outbound": "+youtube+twitch" }, // 匹配 youtube + twitch
      // { "domain_suffix": ["krunker.io", "chess.com", "chesscomfiles.com", "lichess.org", "lichess1.org"], "outbound": "+krunker+chess" }, // 匹配 krunker + chess
      // { "ip_cidr": ["91.105.192.0/23","91.108.4.0/22","91.108.8.0/21","91.108.16.0/21","91.108.56.0/22","149.154.160.0/20","185.76.151.0/24"], "action": "reject" }, // 强制 telegram 走 ipv6 // https://core.telegram.org/resources/cidr.txt
      { "rule_set": ["site-not-cn"], "outbound": "proxy" },
      { "rule_set": ["site-cn", "site-cn-ext"], "outbound": "direct" },
      { "action": "resolve", "server": "google", "client_subnet": "111.0.0.0/10" }, // 弱点在此，冷门的境外域名会被解析，此 subnet 属于中国移动
      { "rule_set": ["ip-cn"], "outbound": "direct" },
      { "outbound": "proxy" } // 兜底，也就是很多机场规则里的 漏网之鱼
    ],
    "auto_detect_interface": true // 防止环路
  },
  "inbounds": [
    {
      "type": "tun", // 当应用不理会环境变量时，以 tun 为兜底措施
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"], // 即便原本无 ipv6 接入，tun 的地址也会让应用误以为可用，见 issue 932。用 prefer_ipv4 无法避免问题，因为微信等应用会使用内置 doh
      "route_exclude_address": ["111.0.0.0/10"], // 绕过 tun，适用于内网的、大流量的、需要 nat 打洞的。注意不要包含上面的 tun 自身与 fakeip
      "exclude_package": ["com.zhihu.android", "com.coolapk.market"], // 与上文 route.rules.package_name 不同，此列表直接绕过 tun，似乎解决了下面的 知乎 挂掉的问题
      "auto_route": true,
      "strict_route": true, // 避免各种流量泄漏。可能造成无法使用 android 局域网分享，在某些旧 windows 中可能需禁用此项并使用 gvisor stack，详见文档
      "platform": { "http_proxy": { "enabled": true, "server": "127.0.0.1", "server_port": 9091 } } // 在 android 上 platform.http_proxy 会让 知乎 等垃圾应用挂掉，但是可以排除应用来解决。也可以按 sfa 里的按钮关闭
    },
    { "type": "mixed", "listen_port": 9091 } // 尽量用开销较小的 socks，主流应用一般都支持，建议设置系统代理。如遇 pip 警告等情况，可以 unset all_proxy ALL_PROXY http_proxy HTTP_PROXY https_proxy HTTPS_PROXY
  ],
  "outbounds": [
    // groups
    {"tag":"proxy","type":"selector","outbounds":["sh-us-hy2","sh-us-stls","sh-us-hy2-v6","sh-us-stls-v6","sh-us-5-hy2","sh-us-5-stls","sh-us-5-hy2-v6","sh-us-5-stls-v6","sh-hk-hy2","sh-hk-stls","sops-sg-1","sops-sg-2","sops-jp-1","sops-jp-2","sops-us-1","sops-us-2"]},
    // {"tag":"+youtube+twitch","type":"selector","outbounds":["proxy","sh-us-stls","sh-us-hy2","sh-hk-stls","sh-hk-hy2"]},
    // {"tag":"+krunker+chess","type":"selector","outbounds":["proxy","direct"]},
    // self-hosted [ aliyun.com | wawo.wiki ]
    {"tag":"sh-hk-stls","detour":"sh-hk-stls-o","type":"shadowsocks","method":"2022-blake3-aes-128-gcm","password":"xxx","multiplex":{"enabled":true,"max_connections":2}},{"tag":"sh-hk-stls-o","type":"shadowtls","server":"1.1.1.1","server_port":11111,"version":3,"password":"xxx","tls":{"enabled":true,"server_name":"v.qq.com"}},
    {"tag":"sh-hk-hy2","type":"hysteria2","server":"1.1.1.1","server_port":11112,"password":"xxx","tls":{"enabled":true,"server_name":"v.qq.com","insecure":true}},
    // mkc - friend - t.me/Maker_Cloud - https://clash2sfa.xmdhs.com/sub?sub=https://example.com/api/v1/client/subscribe?token=xxx
    {"tag":"mkc-hk-1","type":"shadowsocks","server":"1.1.1.1","server_port":11111,"method":"chacha20-ietf-poly1305","password":"xxx"},
    // kity - https|//kaze1.aisaka-taiga.com // imao - t.me/yimaojichang_group - https|//ymjc.cfd/xxx/&flag=sing-box // clash2sfa - https|//clash2sfa.xmdhs.com/sub?sub=https://example.com
    {"tag":"kty-hk-1","type":"shadowsocks","server":"1.1.1.1","server_port":11111,"method":"chacha20-ietf-poly1305","password":"xxx"},
    // lnks
    // {"tag":"lnks-klc2","type":"socks","server":"100.79.45.69","server_port":9091,"detour":"ts-kk-1"}, // {"detour":"lnks-wg"}
    // {"tag":"lnks-direct","type":"socks","server":"192.168.1.1","server_port":1070,"detour":"lnks-wg"}, // 如果有 outbound 走了 443 端口，需要手动 { "detour":"direct" }
    // built-in
    {"tag":"direct","type":"direct"}
  ],
  "endpoints": [
    // {"tag":"ts-kk-1","type":"tailscale"} // 在 connections 栏观察可鉴别 直连/中继，直连时与 derp 域名的连接几乎无流量。使用环境变量 TS_DEBUG_ALWAYS_USE_DERP=true 可强制中继 // mixed/0(tcp) | sing-box-1-12-4 (kkocdko) | derp7b.tailscale.com:443 | "hostname":"klp1"
    // {"tag":"lnks-wg","type":"wireguard","peers":[{"address":"home6.example.org","port":12345,"public_key":"xxx","pre_shared_key":"xxx","allowed_ips":["192.168.0.0/16"]}],"address":["192.168.123.234/32"],"private_key":"xxx","workers":2} // home|home6|homeb6
  ]
}
// >>> server.kvs5
/*
root@kvs5:~# cat /etc/nftables.conf
...
table inet port_forward {
  chain prerouting {
    type nat hook prerouting priority dstnat;
    udp dport 5453-5953 redirect to :5353
  }
}
root@kvs5:~# nft -f /etc/nftables.conf
root@kvs5:~# nft list ruleset
##############################
{
  "experimental": { "clash_api": { "external_controller": "127.0.0.1:9090" } },
  "dns": { "strategy": "prefer_ipv4", "servers": [{ "tag": "local", "type": "local" }] },
  "route": {
    "default_domain_resolver": "local",
    "rules": [
      // { "domain_suffix": ["deepmind.google", "deepmind.com", "geller-pa.googleapis.com", "generativelanguage.googleapis.com", "proactivebackend-pa.googleapis.com", "ai.google.dev", "alkalicore-pa.clients6.google.com", "alkalimakersuite-pa.clients6.google.com", "generativeai.google", "makersuite.google.com", "aistudio.google.com", "bard.google.com", "gemini.google", "gemini.google.com"], "action": "resolve", "server": "local", "strategy": "prefer_ipv6" },
      { "action": "resolve", "server": "local" },
      { "ip_cidr": "2000::/3", "outbound": "warp-plus-1" },
      { "outbound": "direct" }
    ],
    "auto_detect_interface": true
  },
  "inbounds": [
    {
      "tag": "sh-hk-stls-i",
      "type": "shadowsocks",
      "network": "tcp",
      "listen": "127.0.0.1", // loopback only, used for nat traversal
      "listen_port": 11110,
      "method": "2022-blake3-aes-128-gcm",
      "password": "xxxxxxxxxxxxxxxxxxxxxx==", // sing-box generate rand 16 --base64
      "multiplex": { "enabled": true }
    },
    {
      "tag": "sh-hk-stls",
      "type": "shadowtls",
      "listen": "::",
      "listen_port": 11111,
      "detour": "sh-hk-stls-i",
      "version": 3,
      "users": [{ "password": "xxx" }],
      "handshake": { "server": "v.qq.com", "server_port": 443 }, // tls 1.3
      "strict_mode": true
    },
    {
      "tag": "sh-hk-hy2",
      "type": "hysteria2",
      "listen": "::",
      "listen_port": 11112,
      "users": [{ "password": "xxx" }],
      "tls": {
        "enabled": true,
        "server_name": "v.qq.com",
        "certificate": ["-----BEGIN CERTIFICATE-----","xxx","-----END CERTIFICATE-----"],
        "key": ["-----BEGIN PRIVATE KEY-----","xxx","-----END PRIVATE KEY-----"]
      } // sing-box generate tls-keypair 127.0.0.1 -m 120 > pair.pem
    }
  ],
  "outbounds": [
    {"tag":"direct","type":"direct"}
  ],
  "endpoints": [
    {"tag":"warp-plus-1","type":"wireguard","system":false,"mtu":1280,"address":["172.16.0.2/32","2606:xxxx/128"],"private_key":"xxxx","peers":[{"address":"engage.cloudflareclient.com","port":2408,"allowed_ips":["0.0.0.0/0","::/0"],"public_key":"xxxx"}]}
  ]
}
*/
