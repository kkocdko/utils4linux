+pub fn is_managed_mitm_ca_trust_bundle_path(_path: &str) -> bool { false }
+pub fn has_proxy_url_env_vars(_env: &HashMap<String, String>) -> bool { false }
+pub fn proxy_url_env_value<'a>(_env: &'a HashMap<String, String>, _key: &str) -> Option<&'a str> { None }
+pub fn strip_managed_proxy_env(_env: &mut HashMap<String, String>) {}
+pub fn write_attribution_frame(_writer: &mut impl std::io::Write, _token: &str) -> std::io::Result<()> { Ok(()) }
+
