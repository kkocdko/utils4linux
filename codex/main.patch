+    pub user_account_id: Option<String>,
+    pub auth_mode: Option<String>,
+    pub originator: Option<String>,
+    pub user_email: Option<String>,
+    pub terminal_type: Option<String>,
+    pub model: Option<String>,
+    pub slug: Option<String>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct NetworkProxy;
+
+impl NetworkProxy {
+    pub fn builder() -> NetworkProxyBuilder { NetworkProxyBuilder }
+    pub fn managed_mitm_ca_trust_bundle_path(&self) -> Option<codex_utils_absolute_path::AbsolutePathBuf> { None }
+    pub fn http_addr(&self) -> std::net::SocketAddr { std::net::SocketAddr::from(([127, 0, 0, 1], 0)) }
+    pub fn socks_addr(&self) -> std::net::SocketAddr { self.http_addr() }
+    pub async fn current_cfg(&self) -> Result<NetworkProxyConfig> { Ok(NetworkProxyConfig::default()) }
+    pub async fn add_allowed_domain(&self, _host: &str) -> Result<()> { Ok(()) }
+    pub async fn add_denied_domain(&self, _host: &str) -> Result<()> { Ok(()) }
+    pub fn apply_to_env<T>(&self, _env: T) {}
+    pub fn apply_to_env_for_optional_environment<T>(&self, _env: T, _environment_id: Option<&str>) -> Result<()> { Ok(()) }
+    pub fn restore_brokered_credentials<T>(&self, _env: T, c: &mut [String]) {}
+    pub fn remote_policy_decider(&self) -> Option<Arc<dyn NetworkPolicyDecider>> { None }
+    // pub fn for_execution(&self, _environment_id: &str, _execution_id: &str, _attribution_token: String) -> Result<Self> { Ok(Self) }
+    
+    pub fn for_execution<EP>(&self, environment_id: &str, execution_id: &str, attribution_token: String, environment_policy: Option<EP>, fallback_policy_decider: Option<Arc<dyn NetworkPolicyDecider>>) -> Result<Self> { Ok(Self) }
+
+    pub async fn remote_launch_config(&self) -> Result<RemoteNetworkProxyLaunchConfig> {
+        Ok(RemoteNetworkProxyLaunchConfig::new(
+            RemoteNetworkProxyConfig {
+                enabled: false,
+                enable_socks5: false,
+                enable_socks5_udp: false,
+                allow_upstream_proxy: false,
+                dangerously_allow_all_unix_sockets: false,
+                mode: NetworkMode::Full,
+                domains: None,
+                unix_sockets: None,
+                allow_local_binding: false,
+            },
+        ))
+    }
+
+    pub async fn replace_config_state(&self, _state: ConfigState) -> Result<()> { Ok(()) }
+
+    pub async fn run(&self) -> Result<NetworkProxyHandle> { Ok(NetworkProxyHandle) }
+
+    pub fn prepare_for_optional_environment(
+        &self,
+        env: HashMap<String, String>,
+        _environment_id: Option<&str>,
+    ) -> Result<PreparedManagedNetwork> {
+        Ok(PreparedManagedNetwork {
+            env,
+            sandbox_context: ManagedNetworkSandboxContext::default(),
+        })
+    }
+}
